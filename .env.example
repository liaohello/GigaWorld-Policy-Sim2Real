# Copy to .env locally: cp .env.example .env
#
# Every script reads its inputs from here. Nothing in this repository may hardcode
# a machine path; scripts/checks/no_private_paths.sh enforces that on tracked files.
#
# Nothing below should point inside this repository: weights, datasets, caches,
# run outputs and environments all live elsewhere.

# ---- upstream checkouts (not tracked, see external/README.md) --------------
GWP_SOURCE_DIR=              # GigaWorld-Policy checkout (scripts/ + world_action_model/)
ROBOTWIN_SOURCE_DIR=         # RoboTwin 2.0 checkout (must contain XPolicyLab/)
WAM_CPP_SOURCE_DIR=          # wam.cpp checkout
ROBOTWIN_ASSETS_DIR=         # RoboTwin assets tree (~16.6 GB)
ROBOTWIN_DATA_DIR=           # beat_block_hammer demonstrations, read-only

# ---- models ---------------------------------------------------------------
GWP_CHECKPOINT_DIR=          # Giga-World-Policy-0.5 (3 safetensors shards)
WAN_BASE_MODEL_DIR=          # Wan2.2-TI2V-5B-Diffusers

# ---- derived data and outputs (all outside the repo) ----------------------
DATASETS_DIR=                # converted LeRobot v3 datasets + t5_embedding/
GENERATED_DIR=               # expert episodes collected by this project
RUNS_DIR=./runs              # per-run artifacts, videos, traces
ARTIFACTS_DIR=               # normalization JSON, GGUF, merged checkpoint
LOGS_DIR=                    # raw logs
LOCKS_DIR=                   # conda/pip locks, source baseline

# ---- toolchain ------------------------------------------------------------
ENVS_DIR=                    # directory holding robotwin_gwp_{sim,policy,data,tools}
CONDA_ROOT=                  # conda installation whose bin/conda creates the envs
CUDNN_ROOT=                  # cuDNN used to build wam.cpp

# Optional: where giga-models lives if it is not installed in the active env.
# GIGA_MODELS_DIR=
